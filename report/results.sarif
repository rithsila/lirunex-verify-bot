            "category": "Authorization bypass / monetary unit confusion",
            "confidence": "high",
            "findingId": "csf_a83bd9f89e2e5e5c2fc13c0e",
            "occurrenceId": "occ_06b662c8faf9a14b5cb5586f",
            "severity": "medium"
          },
          "ruleId": "authorization-bypass.deposit-currency",
          "ruleIndex": 0
