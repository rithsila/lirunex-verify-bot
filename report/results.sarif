            "findingId": "csf_c6e7ab1274ed75d6dc321d97",
            "occurrenceId": "occ_c9caead5c63d0cc1b5b0f05d",
            "severity": "medium"
          },
          "ruleId": "denial-of-service.browser-concurrency",
          "ruleIndex": 2
        }
