# Lirunex partner portal login (your IB account)
LIRUNEX_PORTAL_URL=https://client.lirunex.online
LIRUNEX_LOGIN_EMAIL=
LIRUNEX_LOGIN_PASSWORD=
# Expected IB name shown in the "Referrer Name" column
LIRUNEX_REFERRER_NAME=Sila Rith
# 64 hex chars (32 bytes) for AES-256-GCM session encryption at rest
SESSION_ENCRYPTION_KEY=
# Shared secret with SafetyScore (HMAC-SHA256 over request body)
LIRUNEX_BOT_HMAC_SECRET=
# Server
PORT=3000
